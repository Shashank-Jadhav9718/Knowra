                <label>Ask a question based on uploaded documents</label>
                <textarea id="queryText" rows="3" placeholder="What is the main topic?"></textarea>
            </div>
            <button onclick="submitQuery()">Submit Query</button>
            <pre id="queryResponse" class="response"></pre>
        </div>

        <!-- SECTION 5: ADMIN -->
        <div class="card">
            <h2>5. Admin</h2>
            <div class="flex-row">
                <button onclick="fetchAdmin('users')">Get Users</button>
                <button onclick="fetchAdmin('logs')">Get Logs</button>
                <button onclick="fetchAdmin('stats')">Get Stats</button>
            </div>
            <pre id="adminResponse" class="response"></pre>
        </div>
    </div>

    <script>
        function getBaseUrl() {
            return document.getElementById('baseUrl').value.replace(/\/$/, '');
        }

        function getHeaders(isFormData = false) {
            const token = document.getElementById('token').value;
            const headers = {};
            if (token) {
                headers['Authorization'] = `Bearer ${token}`;
            }
            if (!isFormData) {
                headers['Content-Type'] = 'application/json';
            }
            return headers;
        }

        function displayResponse(elementId, data, ok) {
            const el = document.getElementById(elementId);
            el.textContent = JSON.stringify(data, null, 2);
            el.className = 'response ' + (ok ? 'success' : 'error');
        }

        async function register() {
            try {
                const res = await fetch(`${getBaseUrl()}/auth/register`, {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({
                        email: document.getElementById('regEmail').value,
                        password: document.getElementById('regPassword').value,
                        organization_id: document.getElementById('regOrgId').value
                    })
                });
                const data = await res.json();
                displayResponse('authResponse', data, res.ok);
            } catch (err) {
                displayResponse('authResponse', { error: err.message }, false);
            }
        }

        async function login() {
            try {
                // OAuth2 password bearer expects form data
                const formData = new URLSearchParams();
                formData.append('username', document.getElementById('loginEmail').value);
                formData.append('password', document.getElementById('loginPassword').value);

                const res = await fetch(`${getBaseUrl()}/auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });
                const data = await res.json();
                if (res.ok && data.access_token) {
                    document.getElementById('token').value = data.access_token;
                }
                displayResponse('authResponse', data, res.ok);
            } catch (err) {
                displayResponse('authResponse', { error: err.message }, false);
            }
        }

        async function uploadDocument() {
            const fileInput = document.getElementById('pdfFile');
            if (!fileInput.files.length) {
                displayResponse('docsResponse', { error: "Please select a file first." }, false);
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);

            try {
                const res = await fetch(`${getBaseUrl()}/documents/upload`, {
                    method: 'POST',
                    headers: getHeaders(true),
                    body: formData
                });
                const data = await res.json();
                displayResponse('docsResponse', data, res.ok);
            } catch (err) {
                displayResponse('docsResponse', { error: err.message }, false);
            }
        }

        async function listDocuments() {
            try {
                const res = await fetch(`${getBaseUrl()}/documents`, {
                    headers: getHeaders()
                });
                const data = await res.json();
                displayResponse('docsResponse', data, res.ok);
            } catch (err) {
                displayResponse('docsResponse', { error: err.message }, false);
            }
        }

        async function deleteDocument() {
            const docId = document.getElementById('deleteDocId').value;
            if (!docId) {
                displayResponse('docsResponse', { error: "Please enter a Document ID." }, false);
                return;
            }
            try {
                const res = await fetch(`${getBaseUrl()}/documents/${docId}`, {
                    method: 'DELETE',
                    headers: getHeaders()
                });
                if (res.status === 204) {
                    displayResponse('docsResponse', { message: "Document deleted successfully." }, true);
                } else {
                    const data = await res.json();
                    displayResponse('docsResponse', data, res.ok);
                }
            } catch (err) {
                displayResponse('docsResponse', { error: err.message }, false);
            }
        }

        async function submitQuery() {
            const query = document.getElementById('queryText').value;
            if (!query) {
                displayResponse('queryResponse', { error: "Please enter a query." }, false);
                return;
            }
            try {
                const res = await fetch(`${getBaseUrl()}/query`, {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ query: query })
                });
                const data = await res.json();
                displayResponse('queryResponse', data, res.ok);
            } catch (err) {
                displayResponse('queryResponse', { error: err.message }, false);
            }
        }

        async function fetchAdmin(endpoint) {
            try {
                const res = await fetch(`${getBaseUrl()}/admin/${endpoint}`, {
                    headers: getHeaders()
                });
                const data = await res.json();
                displayResponse('adminResponse', data, res.ok);
            } catch (err) {
                displayResponse('adminResponse', { error: err.message }, false);
            }
        }
    </script>
</body>
</html>
